{
  "format_version": "1.21.40",
  "minecraft:single_block_feature": {
    "description": {
      "identifier": "example:single_block_weighted"
    },
    "places_block": [
      { "block": "minecraft:pink_petals", "weight": 3 },
      { "block": { "name": "minecraft:pink_petals", "states": { "growth": 2 } }, "weight": 1 }

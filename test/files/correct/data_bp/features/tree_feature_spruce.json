{
  "format_version": "1.21.0",
  "minecraft:tree_feature": {
    "description": {
      "identifier": "example:spruce_tree"
    },
    "base_block": ["minecraft:dirt", "minecraft:grass_block"],
    "may_grow_on": ["minecraft:dirt", "minecraft:grass_block", "minecraft:podzol"],
    "may_replace": ["minecraft:air", "minecraft:spruce_leaves"],
    "trunk": {
      "trunk_height": {
        "range_min": 6,
        "range_max": 9
      },
      "trunk_block": "minecraft:spruce_log",
      "trunk_decoration": {
        "decoration_chance": 0,
        "decoration_block": "minecraft:vine",
        "num_steps": 1,
        "step_direction": "down"
      }
    },
    "spruce_canopy": {
      "lower_offset": {
        "range_min": 0,
        "range_max": 2
      },
      "upper_offset": {
        "range_min": 1,
        "range_max": 2
      },
      "max_radius": [2, 3],
      "leaf_block": "minecraft:spruce_leaves"
    }
  }
}

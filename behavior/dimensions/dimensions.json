{"$schema":"http://json-schema.org/draft-07/schema","$id":"blockception.minecraft.behavior.dimensions","$comment":"UNDOCUMENTED","required":["format_version","minecraft:dimension"],"type":"object","title":"Dimension Behavior","description":"The minecraft dimension behavior specification.","additionalProperties":false,"properties":{"format_version":{"$ref":"#/definitions/A"},"minecraft:dimension":{"$ref":"#/definitions/B"}},"defaultSnippets":[{"label":"New Dimension","body":{"format_version":"${1:1.26.50}","minecraft:dimension":{"description":{"identifier":"$2:${3:${TM_FILENAME/[\\.].*//}}"},"components":{}}}}],"definitions":{"A":{"title":"Format Version","description":"A version that tells minecraft what type of data format can be expected when reading this file.","oneOf":[{"pattern":"^([1-9]+)\\.([0-9]+)\\.([0-9]+)$"},{"const":"beta"}],"type":"string","default":"1.26.0","examples":["1.26.0","1.21.50","1.20.80","1.20.40","1.19.0","1.12.0","1.10.0","1.8.0"],"defaultSnippets":[{"label":"New Format version","body":"1.${1|8,10,12,17,18,19,20|}.${3|2|0|}"}]},"B_components_ref":{"type":"object","title":"Component","description":"The components of this dimension.","additionalProperties":true,"properties":{"minecraft:default_biome":{"$ref":"#/definitions/C"},"minecraft:dimension_height":{"$ref":"#/definitions/D"},"minecraft:generation":{"$ref":"#/definitions/E"}}},"C":{"title":"Default Biome","description":"The biome that fills the dimension.","type":"object","additionalProperties":false,"required":["biome"],"properties":{"biome":{"title":"Biome","description":"The biome Identifier","type":"string"}}},"D":{"title":"Dimension Height","description":"Sets the vertical bounds of the dimension.","type":"object","additionalProperties":false,"required":["min_y","height_range"],"properties":{"height_range":{"title":"Height Range","description":"The number of blocks between the bottom and the top of the dimension.","type":"integer","minimum":16,"maximum":1024,"multipleOf":16},"min_y